{
  "name": "phantom-escape",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w client",
    "build": "npm run build -w client",
    "preview": "npm run preview -w client",
    "test": "npm run test -w client && npm run test -w server",
    "check:media": "node scripts/check-media.mjs",
    "check:docker-client": "node scripts/check-docker-client-copy.mjs",
    "server": "npm run start -w server",
    "check:luminance": "node scripts/luminance-check.mjs",
    "check:leak": "node scripts/leak-check.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "playwright": "^1.65.1"
  }
}
